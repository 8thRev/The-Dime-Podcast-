# Trello Configuration
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_API_TOKEN=your_trello_token_here
TRELLO_BOARD_ID=your_board_id_here
TRELLO_PRE_COLUMN_NAME=Pre

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=8000

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your.email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
EMAIL_FROM=your.email@gmail.com
EMAIL_TO=Bryan.Fields@8threv.com
RESEARCH_EMAIL_CC=team@dimepodcast.com

# General Configuration
TIMEZONE=UTC
DAYS_BEFORE_RECORDING=7


# Isaac Burner, the Answers column (bot/isaac_blogger.py)
# Search Console is optional: without it the column takes its questions from
# the episode catalogue instead of from search demand.
ISAAC_MAX_POSTS=1
ISAAC_QUERY_DAYS=90
ISAAC_MIN_IMPRESSIONS=2
ISAAC_MIN_POSITION=5.0
ISAAC_SOURCE_COUNT=3
ISAAC_MAX_TOKENS=8000
# Set to answer one specific question instead of picking from search data.
ISAAC_FORCE_QUESTION=
