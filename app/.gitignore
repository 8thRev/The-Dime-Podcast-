# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# next-sitemap output (regenerated by the postbuild step in `npm run build`).
# Tracking these means a stale copy can ship if the postbuild step is ever
# skipped — silently, with no signal. public/ is the generator's outDir, so
# these are build artifacts that happen to live beside real static assets.
/public/robots.txt
/public/sitemap.xml
/public/sitemap-*.xml

# Commit marker written by scripts/write-build-info.mjs at build time. Same
# reasoning: a tracked copy would be a stale commit SHA claiming to be the
# deployed one, which is worse than no marker at all.
/public/build-info.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# IDE
.vscode
.idea
*.swp
