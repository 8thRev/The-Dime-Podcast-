# Simplecast RSS Feed URL
NEXT_PUBLIC_SIMPLECAST_FEED_URL=https://feeds.simplecast.com/YOUR_FEED_ID

# ConvertKit API (for optional server-side integration)
CONVERTKIT_API_KEY=your_api_key_here

# GA4 measurement ID. Everything analytics-related is gated on this: with it
# unset, no gtag snippet renders and no event is sent (app/lib/analytics.ts).
# Leave it out of local envs unless you are deliberately testing tracking, and
# use a placeholder rather than the live ID so localhost traffic cannot reach the
# real property.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
