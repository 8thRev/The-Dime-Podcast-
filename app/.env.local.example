# Simplecast RSS Feed URL
NEXT_PUBLIC_SIMPLECAST_FEED_URL=https://feeds.simplecast.com/YOUR_FEED_ID

# ConvertKit API (for optional server-side integration)
CONVERTKIT_API_KEY=your_api_key_here

# GA4 measurement ID. Everything analytics-related is gated on this: with it
# unset, no gtag snippet renders and no event is sent (app/lib/analytics.ts).
# Leave it out of local envs unless you are deliberately testing tracking, and
# use a placeholder rather than the live ID so localhost traffic cannot reach the
# real property.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Resend, for the /sponsorship inquiry form (src/pages/api/sponsor-inquiry.js).
#
# WITHOUT RESEND_API_KEY the form still works but silently degrades: the API
# returns 503 and the browser falls back to opening the visitor's mail client,
# which is exactly the lossy behaviour the endpoint exists to replace. Set this
# in the deployment environment or sponsorship leads will keep going missing.
#
# SPONSOR_FROM_ADDRESS must be on a domain verified in Resend, or every send
# is rejected with a 502.
RESEND_API_KEY=your_resend_api_key_here
SPONSOR_FROM_ADDRESS=The Dime Site <inquiries@dimepodcast.com>
SPONSOR_TO_ADDRESS=sponsorship@dimepodcast.com
