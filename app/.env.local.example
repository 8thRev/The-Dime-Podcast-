# Simplecast RSS Feed URL
NEXT_PUBLIC_SIMPLECAST_FEED_URL=https://feeds.simplecast.com/YOUR_FEED_ID

# Newsletter signup (/newsletter, homepage) — subscribes via ConvertKit's
# v3 API server-side (src/pages/api/newsletter.js). CONVERTKIT_API_KEY is
# under Account Settings > API in ConvertKit; CONVERTKIT_FORM_ID is the
# numeric ID of the "First Principles" form (visible in its ConvertKit URL).
CONVERTKIT_API_KEY=your_api_key_here
CONVERTKIT_FORM_ID=your_form_id_here

# YouTube Data API — powers /videos and the homepage's YouTube section
# (lib/youtube.ts). Create a key at console.cloud.google.com with the
# YouTube Data API v3 enabled.
YOUTUBE_API_KEY=your_youtube_api_key_here

# Contact form (/contact) — delivered via Gmail SMTP through nodemailer.
# GMAIL_USER needs 2-Step Verification enabled; generate GMAIL_APP_PASSWORD
# at https://myaccount.google.com/apppasswords (16-character app password,
# not your normal account password). CONTACT_TO_EMAIL is optional and
# defaults to GMAIL_USER if you want submissions to land in that same inbox.
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
CONTACT_TO_EMAIL=your_gmail_address@gmail.com
