# Simplecast RSS Feed URL
NEXT_PUBLIC_SIMPLECAST_FEED_URL=https://feeds.simplecast.com/YOUR_FEED_ID

# ConvertKit API (for optional server-side integration)
CONVERTKIT_API_KEY=your_api_key_here

# Origin used for the YouTube iframe API ?origin= param on video pages.
# Must match the host serving the site, or GA4 video events never fire.
# Defaults to https://www.dimepodcast.com when unset.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
